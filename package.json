{
  "name": "@damsecure/sizer",
  "version": "0.1.1",
  "description": "Customer-runnable sizing & activity CLI for Dam Secure sales — emits a per-repo CSV fact sheet (file count after standard exclusions, plus 4w/13w/52w commit + committer activity). No pricing logic.",
  "type": "module",
  "private": true,
  "main": "dist/cli.js",
  "bin": {
    "damsecure-sizer": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=DEP0040' tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "test": "NODE_OPTIONS='--disable-warning=DEP0040' vitest run --config vitest.config.ts",
    "preversion": "npm run lint && npm test && npm run build",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "keywords": [
    "damsecure",
    "sizing",
    "sales",
    "cli",
    "github"
  ],
  "author": "Dam Secure",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "minimatch": "^10.2.5",
    "p-limit": "^7.3.0",
    "papaparse": "^5.5.3",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/papaparse": "^5.5.2",
    "nock": "^14.0.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
